<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD Seguro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        html { display:none; }
        
        body {
            background-color: #f8f9fa; 
            font-family: 'Roboto', sans-serif;
            color: #212529; 
        }

        .main-card {
            background: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        /* Estilo para el área del Captcha */
        .captcha-area {
            background-color: #f1f3f5;
            border: 1px dashed #ced4da;
            border-radius: 8px;
        }

        h2 {
            color: #0d6efd; 
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
    </style>
    
    <script nonce="<%= nonce %>">
       if (self === top) { document.documentElement.style.display = 'block'; } else { top.location = self.location; }
    </script>
</head>
<body class="container py-5" oncontextmenu="return false;"> 
    
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4 text-center">CRUD</h2>

            <div class="card card-body mb-5 main-card p-4">
                <form action="/agregar" method="POST" autocomplete="off">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    
                    <div style="display:none !important;" aria-hidden="true">
                        <input type="text" name="especial_field" tabindex="-1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Nombre del Registro</label>
                        <input type="text" name="nombre" class="form-control form-control-lg" placeholder="Ingresa el nombre..." required>
                    </div>

                    <div class="mb-3 p-3 captcha-area">
                        <label class="form-label text-muted small fw-bold">VERIFICACIÓN DE SEGURIDAD</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div style="user-select: none;"> 
                                <img src="/captcha?t=<%= Date.now() %>" alt="captcha" id="captchaImg" class="rounded border bg-white">
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" 
                                    onclick="document.getElementById('captchaImg').src='/captcha?' + Date.now();">
                                ↻ Recargar Imagen
                            </button>
                        </div>
                        <input type="text" name="captcha" class="form-control" placeholder="Escribe los caracteres de la imagen" required autocomplete="off">
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">GUARDAR REGISTRO</button>
                </form>
            </div>

            <div class="card main-card overflow-hidden">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 text-muted">Registros Existentes</h5>
                </div>
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% registros.forEach(reg => { %>
                            <tr>
                                <td class="ps-4 fw-bold text-dark"><%= reg.nombre %></td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-outline-primary btn-sm btn-editar" 
                                            data-id="<%= reg.id %>" 
                                            data-nombre="<%= reg.nombre %>">
                                        Editar
                                    </button>
                                    
                                    <form action="/eliminar" method="POST" class="d-inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="id" value="<%= reg.id %>">
                                        <button class="btn btn-outline-danger btn-sm">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ventanaEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form action="/editar" method="POST" class="modal-content">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Modificar Registro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="form_id">
                    <label class="form-label text-secondary">Nuevo Nombre</label>
                    <input type="text" name="nuevoNombre" id="form_nombre" class="form-control" required>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

