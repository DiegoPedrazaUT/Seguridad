<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>CRUD Blindado</title>
</head>
<body class="container py-5 bg-light">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form action="/agregar" method="POST" class="row g-3">
                <div class="col-auto">
                    <input type="text" name="nombre" class="form-control" placeholder="Nuevo registro" required>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% registros.forEach(reg => { %>
                <tr>
                    <td><%= reg.nombre %></td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm" onclick="abrirEdicion('<%= reg.id %>', '<%= reg.nombre %>')">Editar</button>
                        <form action="/eliminar" method="POST" class="d-inline">
                            <input type="hidden" name="id" value="<%= reg.id %>">
                            <button class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="modal fade" id="modalEdicion" tabindex="-1">
        <div class="modal-dialog">
            <form action="/editar" method="POST" class="modal-content">
                <div class="modal-header"><h5>Actualizar Registro</h5></div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="target_id">
                    <input type="text" name="nuevoNombre" id="target_nombre" class="form-control" required>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function abrirEdicion(id, nombre) {
            document.getElementById('target_id').value = id;
            document.getElementById('target_nombre').value = nombre;
            var bootstrapModal = new bootstrap.Modal(document.getElementById('modalEdicion'));
            bootstrapModal.show();
        }
    </script>
</body>
</html>