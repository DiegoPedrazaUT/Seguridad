<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>CRUD Seguro | Mi Proyecto</title>
</head>
<body class="bg-light container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Gestión de Usuarios</h4>
        </div>
        <div class="card-body">
            <form action="/agregar" method="POST" class="row g-3 mb-4">
                <div class="col-auto">
                    <input type="text" name="nombre" class="form-control" placeholder="Ingrese un nombre" required>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Registrar</button>
                </div>
            </form>

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% registros.forEach(reg => { %>
                        <tr>
                            <td><%= reg.nombre %></td>
                            <td class="text-end">
                                <button class="btn btn-outline-warning btn-sm" 
                                        onclick="prepararEdicion('<%= reg.id %>', '<%= reg.nombre %>')">
                                    Editar
                                </button>
                                <form action="/eliminar" method="POST" class="d-inline">
                                    <input type="hidden" name="id" value="<%= reg.id %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1">
        <div class="modal-dialog">
            <form action="/editar" method="POST" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Actualizar Nombre</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="input_id">
                    <div class="mb-3">
                        <label class="form-label">Nombre actual o nuevo:</label>
                        <input type="text" name="nuevoNombre" id="input_nombre" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function prepararEdicion(id, nombre) {
            // Pasamos los datos al modal
            document.getElementById('input_id').value = id;
            document.getElementById('input_nombre').value = nombre;
            
            // Activamos el modal manualmente por seguridad
            const elModal = new bootstrap.Modal(document.getElementById('modalEditar'));
            elModal.show();
        }
    </script>
</body>
</html>